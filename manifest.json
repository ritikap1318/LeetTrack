{
  "manifest_version": 3,
  "name": "LeetCode 1-3-7 Revisor",
  "version": "1.0",
  "description": "Spaced repetition tracker for LeetCode problems.",
  "permissions": [
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png"
  }
}